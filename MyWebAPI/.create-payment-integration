4. **yourname.js structure:**
   ```javascript
   import { fillCheckoutForm } from "../test/devFillers.js";

   // State
   let paymentToken = null;

   // Initialize
   document.addEventListener("DOMContentLoaded", () => {
     const form = document.getElementById("paymentForm");
     form.addEventListener("submit", handleSubmit);
     
     // Optional: add auto-fill button for testing
     const fillBtn = document.createElement("button");
     fillBtn.type = "button";
     fillBtn.textContent = "Fill Test Data";
     fillBtn.addEventListener("click", fillCheckoutForm);
     form.appendChild(fillBtn);
   });

   function getFormData() {
     const formData = {};
     document.querySelectorAll("#paymentForm input").forEach(el => {
       if (el.name) formData[el.name] = el.value;
     });
     return formData;
   }

   async function handleSubmit(e) {
     e.preventDefault();
     
     try {
       showProcessing(true);
       showMessage("info", "Processing payment...");
       
       const formData = getFormData();
       const response = await fetch("/api/yourname/process", {
         method: "POST",
         headers: { "Content-Type": "application/json" },
         body: JSON.stringify(formData),
       });
       
       if (!response.ok) {
         throw new Error(`API Error: ${response.status}`);
       }
       
       const result = await response.json();
       
       if (result.success) {
         showMessage("success", "Payment processed!");
         setTimeout(() => {
           window.location.href = `/success.html?txnId=${result.transactionId}`;
         }, 1500);
       } else {
         showMessage("error", result.error || "Payment failed");
       }
     } catch (error) {
       showMessage("error", error.message);
     } finally {
       showProcessing(false);
     }
   }

   function showProcessing(isProcessing) {
     const btn = document.querySelector("button[type=submit]");
     btn.disabled = isProcessing;
     btn.textContent = isProcessing ? "Processing..." : "Process Payment";
   }

   function showMessage(type, message) {
     const container = document.getElementById("messageContainer");
     const alertClass = type === "error" ? "danger" : type;
     container.innerHTML = `
       <div class="alert alert-${alertClass} alert-dismissible fade show" role="alert">
         ${message}
         <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
       </div>
     `;
   }
   ```

