{
  "name": "@nmipayments/nmi-reporting",
  "version": "0.0.3",
  "description": "NMI Embedded Component for Reporting",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "dist/index.js",
    "src/NmiReportingWidget.svelte",
    "src/NmiDepositReportingWidget.svelte",
    "src/NmiTransactionReportingWidget.svelte"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "@nmipayments/nmi-core": "^1.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.15.17",
    "eslint": "^9.17.0",
    "rimraf": "^5.0.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.3.0",
    "rollup-plugin-terser": "^7.0.2"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build:dev": "vite build --mode development",
    "build": "tsc --noEmit && vite build",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts"
  }
}